FROM chatay-resilientdb-hs1-pr100:runtime-v2.13.20-alpha.1

ARG CHATAY_SEMVER
ARG SOURCE_COMMIT
ARG SOURCE_BRANCH

LABEL org.chatay.consensus="hs1-pr100" \
      org.chatay.image_role="runtime-release" \
      org.chatay.semver="${CHATAY_SEMVER}" \
      org.chatay.source_commit="${SOURCE_COMMIT}" \
      org.chatay.source_branch="${SOURCE_BRANCH}" \
      org.chatay.base_image="chatay-resilientdb-hs1-pr100:runtime-v2.13.20-alpha.1"

WORKDIR /opt/resilientdb-hs1

COPY runtime-context/bin/kv_service /opt/resilientdb-hs1/bin/kv_service
COPY runtime-context/bin/kv_service_tools /opt/resilientdb-hs1/bin/kv_service_tools
COPY runtime-context/bin/certificate_tools /opt/resilientdb-hs1/bin/certificate_tools
COPY runtime-context/bin/key_generator_tools /opt/resilientdb-hs1/bin/key_generator_tools
COPY runtime-context/bin/generate_region_config /opt/resilientdb-hs1/bin/generate_region_config
COPY runtime-context/chatay-runtime-manifest.json /chatay-runtime-manifest.json
COPY runtime-context/chatay-runtime-files.txt /chatay-runtime-files.txt

RUN chmod +x /opt/resilientdb-hs1/bin/* && \
    ln -sf /opt/resilientdb-hs1/bin/kv_service /usr/local/bin/chatay-hs1-kv_service && \
    ln -sf /opt/resilientdb-hs1/bin/kv_service_tools /usr/local/bin/chatay-hs1-kv_service_tools

CMD ["sleep", "infinity"]
